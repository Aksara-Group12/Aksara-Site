---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { principlesEn, processStepsEn } from '../../data/content';
import { techLayersEn } from '../../data/stack';

const principles = principlesEn;
const processSteps = processStepsEn;
const techLayers = techLayersEn;
---

<Base
  title="About"
  description="Aksara Developer is a software engineering partner based in Jember since 2026. Websites, web apps, and mobile apps built with transparent workflows and full source code ownership."
  lang="en"
>
  <PageHero
    eyebrow="About"
    title="Getting to Know Aksara Developer"
    description="A software engineering studio combining modern visual aesthetics with robust clean code architecture for websites, web applications, and mobile apps of all scales."
    breadcrumb={[{ label: 'Home', href: '/en' }, { label: 'About' }]}
  />

  <section class="shell border-t border-line pb-16">
    <div class="max-w-3xl reveal">
      <p class="eyebrow">Company Profile</p>
      <div class="mt-6 space-y-6 text-[15px] leading-relaxed text-navy-700">
        <p>
          Aksara Developer is an independent software house based in Jember, East Java, founded in 2026.
          Two engineers, focused minds, and one conviction: growing businesses deserve neat, modular software
          without paying big agency overhead.
        </p>
        <p>
          From high-converting corporate portals and campaign landing pages to complex internal workflow
          systems and mobile applications, we are committed to delivering exceptional craftsmanship through
          transparent, anxiety-free execution.
        </p>
        <p>
          We focus squarely on robust software engineering and high-performance web systems. We
          deliberately refrain from offering generic social media marketing or superficial branding — we believe
          in mastering software engineering deeply and delivering it properly.
        </p>
        <p>
          If you are reading this and feel your project might be considered "too small" for a conventional agency,
          that is precisely where we excel. We will never promise unattainable fantasies or quote arbitrary fees
          that cannot be justified by real technical substance.
        </p>
      </div>
    </div>
  </section>

  <section class="relative border-t border-line py-20">
    <div class="shell">
      <p class="eyebrow reveal">Core Principles</p>
      <h2 class="mt-5 max-w-xl text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl reveal">
        Four non-negotiable standards.
      </h2>

      <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          principles.map((item, index) => (
            <div class="reveal flex gap-4">
              <span class="mt-0.5 font-mono text-xs text-gold-500/70">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-base font-semibold text-navy-950">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-navy-700">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative border-t border-line py-20 tech-section">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div class="reveal">
          <p class="eyebrow">Tooling & Stack</p>
          <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
            What we use daily.
          </h2>
        </div>
        <div class="divide-y divide-line border-t border-line">
          {
            techLayers.map((layer) => (
              <div class="grid gap-3 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <h3 class="tech-label text-sm font-semibold text-navy-950">{layer.group}</h3>
                <div class="flex flex-wrap gap-1.5">
                  {layer.items.map((item) => <span class="tech-item chip">{item}</span>)}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="relative border-y border-line bg-parchment-200/30 py-20">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div class="reveal">
          <p class="eyebrow">Workflow</p>
          <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
            Six disciplined stages, zero blackout periods.
          </h2>
        </div>
        <ol class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            processSteps.map((step) => (
              <li>
                <p class="font-mono text-[11px] text-gold-500/70">{step.number}</p>
                <h3 class="mt-1.5 text-sm font-semibold text-navy-950">{step.title}</h3>
                <p class="mt-1.5 text-[13px] leading-relaxed text-navy-700">{step.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CtaBand
    lang="en"
    title="Want to speak directly with the engineers?"
    description="No formal presentations required. Tell us what operational process is slowing your business down today."
    secondaryLabel="View portfolio"
    secondaryHref="/en/portfolio"
  />
</Base>


<style>
  /* Khusus animasi interaktif saat disentuh / di-hover pada bagian Alat Kerja */
  .tech-section .tech-label {
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .tech-section .tech-label:hover {
    color: var(--color-gold-600);
    transform: translateX(3px);
  }

  .tech-section .tech-item {
    cursor: pointer;
    user-select: none;
    position: relative;
    transition:
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      letter-spacing 0.22s ease;
  }

  /* Efek animasi saat kursor/jari menyentuh teks teknologi */
  .tech-section .tech-item:hover {
    transform: translateY(-3px) scale(1.08);
    border-color: rgba(200, 150, 60, 0.75);
    background-color: rgba(200, 150, 60, 0.12);
    color: var(--color-navy-950);
    letter-spacing: 0.04em;
    box-shadow:
      0 6px 14px -3px rgba(10, 28, 51, 0.14),
      0 0 14px 1px rgba(200, 150, 60, 0.28);
    animation: techChipWiggle 0.45s ease-in-out;
  }

  /* Animasi sentuhan membal (wiggle pop) */
  @keyframes techChipWiggle {
    0% {
      transform: translateY(0) scale(1);
    }
    35% {
      transform: translateY(-4px) scale(1.1) rotate(-1.5deg);
    }
    70% {
      transform: translateY(-3px) scale(1.07) rotate(1deg);
    }
    100% {
      transform: translateY(-3px) scale(1.08) rotate(0deg);
    }
  }

  /* Feedback saat ditekan/disentuh di smartphone atau diklik */
  .tech-section .tech-item:active {
    transform: translateY(0) scale(0.95);
    transition-duration: 0.1s;
  }
</style>
