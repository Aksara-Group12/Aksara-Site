---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { site, waLink } from '../data/site';

const budgets = ['Di bawah Rp 5 juta', 'Rp 5–15 juta', 'Rp 15–40 juta', 'Di atas Rp 40 juta', 'Belum tahu'];
const interests = ['Website bisnis', 'Aplikasi web', 'Aplikasi mobile', 'Perawatan bulanan', 'Belum yakin'];
---

<Base
  title="Kontak"
  description="Diskusi gratis 45 menit untuk memetakan kebutuhan digital bisnis Anda. Balasan rata-rata di bawah 2 jam pada hari kerja."
>
  <PageHero
    eyebrow="Kontak"
    title="Mulai dari percakapan, bukan dari proposal."
    description="Isi form atau langsung chat WhatsApp. Kami akan balas dengan pertanyaan yang relevan, bukan template penawaran yang sama untuk semua orang."
    breadcrumb={[{ label: 'Beranda', href: '/' }, { label: 'Kontak' }]}
  />

  <section class="shell pb-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_0.85fr] lg:gap-14">
      <form
        action={`https://formsubmit.co/${site.email}`}
        method="POST"
        class="card space-y-6 p-6 md:p-8"
        data-contact-form
      >
        <input type="hidden" name="_subject" value="Pesan baru dari website Aksara Developer" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-1">
            <label for="nama" class="block text-xs font-medium text-navy-700">Nama lengkap</label>
            <input
              id="nama"
              name="nama"
              type="text"
              required
              autocomplete="name"
              placeholder="Nama Anda"
              class="mt-2 w-full rounded-xl border border-line bg-parchment-200 px-3.5 py-2.5 text-sm text-navy-950 placeholder:text-navy-600/60 focus:border-gold-500 focus:outline-none"
            />
          </div>

          <div class="sm:col-span-1">
            <label for="wa" class="block text-xs font-medium text-navy-700">Nomor WhatsApp</label>
            <input
              id="wa"
              name="whatsapp"
              type="tel"
              required
              autocomplete="tel"
              inputmode="tel"
              placeholder="0812xxxxxxx"
              class="mt-2 w-full rounded-xl border border-line bg-parchment-200 px-3.5 py-2.5 text-sm text-navy-950 placeholder:text-navy-600/60 focus:border-gold-500 focus:outline-none"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="email" class="block text-xs font-medium text-navy-700">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="nama@perusahaan.com"
              class="mt-2 w-full rounded-xl border border-line bg-parchment-200 px-3.5 py-2.5 text-sm text-navy-950 placeholder:text-navy-600/60 focus:border-gold-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="layanan" class="block text-xs font-medium text-navy-700">Minat layanan</label>
            <select
              id="layanan"
              name="layanan"
              class="mt-2 w-full appearance-none rounded-xl border border-line bg-parchment-200 px-3.5 py-2.5 text-sm text-navy-950 focus:border-gold-500 focus:outline-none"
            >
              {interests.map((item) => <option value={item}>{item}</option>)}
            </select>
          </div>

          <div>
            <label for="budget" class="block text-xs font-medium text-navy-700">Perkiraan anggaran</label>
            <select
              id="budget"
              name="budget"
              class="mt-2 w-full appearance-none rounded-xl border border-line bg-parchment-200 px-3.5 py-2.5 text-sm text-navy-950 focus:border-gold-500 focus:outline-none"
            >
              {budgets.map((item) => <option value={item}>{item}</option>)}
            </select>
          </div>

          <div class="sm:col-span-2">
            <label for="pesan" class="block text-xs font-medium text-navy-700">Ceritakan singkat project Anda</label>
            <textarea
              id="pesan"
              name="pesan"
              rows="5"
              required
              placeholder="Bisnis apa yang Anda jalankan, masalah apa yang ingin diselesaikan, dan kapan targetnya?"
              class="mt-2 w-full resize-y rounded-xl border border-line bg-parchment-200 px-3.5 py-2.5 text-sm leading-relaxed text-navy-950 placeholder:text-navy-600/60 focus:border-gold-500 focus:outline-none"
            ></textarea>
          </div>
        </div>

        <div class="flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-xs text-[11px] leading-relaxed text-navy-600">
            Data hanya dipakai untuk membalas pesan Anda. Tidak dibagikan ke pihak ketiga.
          </p>
          <button type="submit" class="btn btn-primary">
            Kirim pesan
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </form>

      <aside class="space-y-4">
        <a
          href={waLink()}
          target="_blank"
          rel="noopener"
          class="card group flex items-start gap-4 p-6"
        >
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-gold-500/30 bg-gold-500/10 text-gold-600">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2m-3.6 6.1c.15 0 .35-.06.55.42.21.49.7 1.71.76 1.83.06.13.11.28.02.44-.08.17-.12.28-.25.42-.12.15-.26.32-.37.44-.12.12-.25.25-.11.5.14.25.61 1.01 1.38 1.72.95.84 1.75 1.11 2 1.23.25.13.4.11.54-.06.15-.17.63-.73.8-.98.16-.25.33-.21.56-.12.23.08 1.45.68 1.7.81.25.12.42.19.48.29.06.1.06.6-.14 1.18-.21.58-1.2 1.11-1.68 1.18-.43.06-.97.09-1.57-.1-.36-.11-.82-.26-1.41-.52-2.49-1.07-4.11-3.56-4.24-3.74-.13-.16-1.03-1.36-1.03-2.6s.65-1.85.88-2.1c.23-.25.5-.31.67-.31" />
            </svg>
          </span>
          <div>
            <h2 class="text-sm font-semibold text-navy-950 group-hover:text-gold-600">WhatsApp langsung</h2>
            <p class="mt-1 text-[13px] text-navy-700">{site.phone}</p>
            <p class="mt-2 text-[11px] text-navy-600">Paling cepat. Rata-rata dibalas di bawah 2 jam.</p>
          </div>
        </a>

        <div class="card p-6">
          <h2 class="text-sm font-semibold text-navy-950">Email</h2>
          <a href={`mailto:${site.email}`} class="mt-1 block text-[13px] text-navy-700 transition-colors hover:text-gold-600">
            {site.email}
          </a>
          <p class="mt-2 text-[11px] text-navy-600">Cocok untuk dokumen, RFP, atau undangan tender.</p>
        </div>

        <div class="card p-6">
          <h2 class="text-sm font-semibold text-navy-950">Jam kerja</h2>
          <dl class="mt-3 space-y-2 text-[13px]">
            <div class="flex justify-between gap-4">
              <dt class="text-navy-600">Senin–Jumat</dt>
              <dd class="text-navy-900">09.00–18.00</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-navy-600">Sabtu</dt>
              <dd class="text-navy-900">10.00–14.00</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-navy-600">Minggu &amp; libur</dt>
              <dd class="text-navy-600">Tutup</dd>
            </div>
          </dl>
          <p class="mt-3 border-t border-line pt-3 text-[11px] text-navy-600">Waktu Indonesia Barat (WIB)</p>
        </div>

        <div class="rounded-[1.25rem] border border-line bg-parchment-50/40 p-6">
          <p class="text-[13px] leading-relaxed text-navy-700">
            Anda punya dokumen RFP, wireframe, atau referensi situs? Kirim lewat email dan sebutkan
            di pesan. Kami baca semuanya sebelum sesi diskusi.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <Faq />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', () => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Mengirim…';
    }
  });
</script>
