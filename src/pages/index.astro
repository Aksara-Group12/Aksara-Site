---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Process from '../components/Process.astro';
import WhyUs from '../components/WhyUs.astro';
import TechStack from '../components/TechStack.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
---

<Base title={site.name} description={site.description} ogTitle="Aksara Developer — Software house untuk bisnis yang serius tumbuh">
  <Hero />
  <ServicesGrid />
  <FeaturedWork />
  <Process />
  <WhyUs />
  <TechStack />
  <Testimonials />
  <Faq />
  <CtaBand />
</Base>
