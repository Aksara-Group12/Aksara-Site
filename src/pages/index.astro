---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Process from '../components/Process.astro';
import WhyUs from '../components/WhyUs.astro';
import TechStack from '../components/TechStack.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { siteId } from '../data/site';
---

<Base title={siteId.name} description={siteId.description} ogTitle="Aksara Developer — Software house untuk bisnis yang serius tumbuh" lang="id">
  <Hero lang="id" />
  <ServicesGrid lang="id" />
  <FeaturedWork lang="id" />
  <Process lang="id" />
  <WhyUs lang="id" />
  <TechStack lang="id" />
  <Testimonials lang="id" />
  <Faq lang="id" />
  <CtaBand lang="id" />
</Base>
