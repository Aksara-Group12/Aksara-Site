---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { principlesId, processStepsId } from '../data/content';
import { techLayersId } from '../data/stack';

const principles = principlesId;
const processSteps = processStepsId;
const techLayers = techLayersId;
---

<Base
  title="Tentang"
  description="Aksara Developer adalah mitra rekayasa perangkat lunak di Jember sejak 2026. Website, aplikasi web, dan aplikasi mobile dengan proses transparan dan source code milik klien."
  lang="id"
>
  <PageHero
    eyebrow="Tentang"
    title="Mengenal Aksara Developer Lebih Dekat"
    description="Mitra rekayasa perangkat lunak yang menggabungkan estetika visual modern dengan keandalan arsitektur kode yang bersih, untuk website bisnis, aplikasi web, dan aplikasi mobile segala skala."
    breadcrumb={[{ label: 'Beranda', href: '/' }, { label: 'Tentang' }]}
  />

  <section class="shell border-t border-line pb-16">
    <div class="max-w-3xl reveal">
      <p class="eyebrow">Profil Perusahaan</p>
      <div class="mt-6 space-y-6 text-[15px] leading-relaxed text-navy-700">
        <p>
          Aksara Developer adalah software house yang berbasis di Jember dan berdiri pada 2026. Dua
          orang, satu laptop, dan satu keyakinan: bisnis kecil berhak mendapat pekerjaan teknis yang
          rapi tanpa harga agency besar.
        </p>
        <p>
          Mulai dari website profil bisnis, landing page kampanye, sistem internal, hingga aplikasi
          mobile, kami berkomitmen memberikan hasil terbaik lewat proses pengerjaan yang transparan
          dan bebas khawatir.
        </p>
        <p>
          Kami berfokus penuh pada rekayasa sistem dan website yang fungsional. Kami sengaja tidak
          melebar ke digital marketing atau branding, karena lebih baik menguasai sedikit hal dengan
          benar.
        </p>
        <p>
          Kalau Anda membaca ini dan merasa project Anda terlalu kecil untuk agency, justru di situ
          kami paling berguna. Yang kami tidak lakukan adalah menjanjikan hasil mustahil atau
          memasang harga yang tidak bisa kami pertanggungjawabkan.
        </p>
      </div>
    </div>
  </section>

  <section class="relative border-t border-line py-20">
    <div class="shell">
      <p class="eyebrow reveal">Prinsip kerja</p>
      <h2 class="mt-5 max-w-xl text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl reveal">
        Empat aturan yang tidak kami tawar.
      </h2>

      <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          principles.map((item, index) => (
            <div class="reveal flex gap-4">
              <span class="mt-0.5 font-mono text-xs text-gold-500/70">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-base font-semibold text-navy-950">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-navy-700">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative border-t border-line py-20 tech-section">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div class="reveal">
          <p class="eyebrow">Alat kerja</p>
          <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
            Yang kami pakai sehari-hari.
          </h2>
        </div>
        <div class="divide-y divide-line border-t border-line">
          {
            techLayers.map((layer) => (
              <div class="grid gap-3 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <h3 class="tech-label text-sm font-semibold text-navy-950">{layer.group}</h3>
                <div class="flex flex-wrap gap-1.5">
                  {layer.items.map((item) => <span class="tech-item chip">{item}</span>)}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="relative border-y border-line bg-parchment-200/30 py-20">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div class="reveal">
          <p class="eyebrow">Cara kerja</p>
          <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
            Enam tahap, tanpa fase gelap.
          </h2>
        </div>
        <ol class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            processSteps.map((step) => (
              <li>
                <p class="font-mono text-[11px] text-gold-500/70">{step.number}</p>
                <h3 class="mt-1.5 text-sm font-semibold text-navy-950">{step.title}</h3>
                <p class="mt-1.5 text-[13px] leading-relaxed text-navy-700">{step.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CtaBand
    lang="id"
    title="Mau ngobrol langsung dengan founder?"
    description="Tidak perlu presentasi formal. Cukup ceritakan apa yang sedang macet di bisnis Anda sekarang."
    secondaryLabel="Lihat portfolio"
    secondaryHref="/portfolio"
  />
</Base>


<style>
  /* Khusus animasi interaktif saat disentuh / di-hover pada bagian Alat Kerja */
  .tech-section .tech-label {
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .tech-section .tech-label:hover {
    color: var(--color-gold-600);
    transform: translateX(3px);
  }

  .tech-section .tech-item {
    cursor: pointer;
    user-select: none;
    position: relative;
    transition:
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      letter-spacing 0.22s ease;
  }

  /* Efek animasi saat kursor/jari menyentuh teks teknologi */
  .tech-section .tech-item:hover {
    transform: translateY(-3px) scale(1.08);
    border-color: rgba(200, 150, 60, 0.75);
    background-color: rgba(200, 150, 60, 0.12);
    color: var(--color-navy-950);
    letter-spacing: 0.04em;
    box-shadow:
      0 6px 14px -3px rgba(10, 28, 51, 0.14),
      0 0 14px 1px rgba(200, 150, 60, 0.28);
    animation: techChipWiggle 0.45s ease-in-out;
  }

  /* Animasi sentuhan membal (wiggle pop) */
  @keyframes techChipWiggle {
    0% {
      transform: translateY(0) scale(1);
    }
    35% {
      transform: translateY(-4px) scale(1.1) rotate(-1.5deg);
    }
    70% {
      transform: translateY(-3px) scale(1.07) rotate(1deg);
    }
    100% {
      transform: translateY(-3px) scale(1.08) rotate(0deg);
    }
  }

  /* Feedback saat ditekan/disentuh di smartphone atau diklik */
  .tech-section .tech-item:active {
    transform: translateY(0) scale(0.95);
    transition-duration: 0.1s;
  }
</style>
