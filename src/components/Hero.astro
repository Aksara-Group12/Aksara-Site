---
import { waLink } from '../data/site';
import LogoMark from '../components/LogoMark.astro';
---

<section class="relative overflow-hidden pt-16 pb-12 md:pt-20 md:pb-16 min-h-[560px] lg:min-h-[640px] flex items-center">
  <div class="grid-lines"></div>
  <div class="glow -top-32 left-1/2 size-[42rem] -translate-x-1/2 text-gold-400/18"></div>
  <div class="glow glow-drift -top-10 right-0 size-[28rem] text-steel-500/15"></div>

  <!-- Massive Watermark Logo on the right (matching user yellow boundary) -->
  <div
    class="pointer-events-none select-none absolute right-[-8%] sm:right-[-4%] lg:right-[0%] xl:right-[2%] top-1/2 -translate-y-1/2 w-[78vw] sm:w-[62vw] lg:w-[50vw] xl:w-[47vw] max-w-[880px] aspect-[1328/1527] flex items-center justify-center opacity-80 lg:opacity-100"
  >
    <!-- Subtle radial glow behind the emblem -->
    <div class="absolute inset-0 bg-radial from-steel-500/15 dark:from-gold-400/15 via-transparent to-transparent blur-3xl opacity-80"></div>

    <LogoMark
      outline={true}
      strokeWidth="1.85"
      strokeOpacity="0.5"
      fillOpacity="0.04"
      class="w-full h-full text-navy-800/45 dark:text-gold-400/45 filter drop-shadow-[0_0_32px_rgba(74,123,167,0.18)] dark:drop-shadow-[0_0_32px_rgba(217,176,106,0.18)] transition-all duration-500"
    />
  </div>

  <div class="shell relative z-10 w-full py-4">
    <div class="max-w-xl lg:max-w-2xl">
      <div data-hero>
        <p class="eyebrow">Software Company</p>

        <h1
          class="mt-6 text-[2.6rem] leading-[1.02] font-extrabold tracking-[-0.035em] text-navy-950 sm:text-[3.6rem] lg:text-[3.9rem]"
        >
          Kode yang rapi.<br />
          Bisnis yang<br />
          <span class="text-gold-600">jalan lebih cepat.</span>
        </h1>

        <p class="mt-6 max-w-lg text-[15px] leading-relaxed text-navy-700 md:text-base">
          Aksara Developer membangun website, sistem operasional, dan aplikasi mobile untuk UMKM
          dan startup Indonesia yang sudah lelah menambal banyak tools. Satu tim, satu titik
          tanggung jawab.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={waLink()} target="_blank" rel="noopener" class="btn btn-primary">
            Diskusi project Anda
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="/portfolio" class="btn btn-ghost">
            Lihat hasil kerja
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
