---
import { waLink } from '../data/site';
import { featuredProject as featured } from '../data/projects';
---

<section class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <div class="grid-lines"></div>
    <div class="glow -top-32 left-1/2 size-[42rem] -translate-x-1/2 text-gold-400/18"></div>
    <div class="glow glow-drift -top-10 right-0 size-[24rem] text-steel-500/12"></div>

  <div class="shell relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div data-hero>
        <p class="eyebrow">Software Company</p>

        <h1
          class="mt-6 text-[2.6rem] leading-[1.02] font-extrabold tracking-[-0.035em] text-navy-950 sm:text-[3.6rem] lg:text-[4rem]"
        >
          Kode yang rapi.<br />
          Bisnis yang<br />
          <span class="text-gold-600">jalan lebih cepat.</span>
        </h1>

        <p class="mt-7 max-w-lg text-[15px] leading-relaxed text-navy-700 md:text-base">
          Aksara Developer membangun website, sistem operasional, dan aplikasi mobile untuk UMKM
          dan startup Indonesia yang sudah lelah menambal banyak tools. Satu tim, satu titik
          tanggung jawab.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={waLink()} target="_blank" rel="noopener" class="btn btn-primary">
            Diskusi project Anda
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="/portfolio" class="btn btn-ghost">
            Lihat hasil kerja
          </a>
        </div>
      </div>

        <div class="relative">
        <div class="frame-gold relative overflow-hidden bg-parchment-50 px-6 pt-8 pb-6 shadow-[0_36px_70px_-40px_rgba(10,28,51,0.55)]">
          <div class="grid-lines opacity-70"></div>
          <div class="relative flex flex-col items-center text-center">
            <span class="logo-chip size-44">
              <img src="/logo-mark.png" alt="" width="384" height="376" />
            </span>
            <p class="text-serif mt-4 text-[11px] tracking-[0.22em] text-gold-700 uppercase">Aksara Developer</p>
          </div>
        </div>

        {
          featured && (
            <a
              href={featured.url}
              target="_blank"
              rel="noopener noreferrer"
              class="surface-navy absolute -bottom-6 left-4 right-4 rounded-2xl border border-gold-500/30 px-4 py-4 shadow-[0_22px_40px_-28px_rgba(10,28,51,0.85)] sm:left-6 sm:right-auto sm:w-[17rem]"
            >
              <p class="text-[10px] tracking-[0.16em] text-gold-300 uppercase">{featured.industry}</p>
              <p class="mt-1.5 text-sm leading-snug font-semibold text-on-deep">{featured.title}</p>
              <p class="mt-3 flex items-center gap-1.5 text-[11px] text-gold-300">
                <span class="size-1.5 rounded-full bg-gold-300"></span>
                Live · buka website
              </p>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
