---
import ProjectCard from './ProjectCard.astro';
import { getProjects } from '../data/projects';
import { ui, type Locale } from '../data/i18n';

interface Props {
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { lang = detectedLocale } = Astro.props;

const t = ui[lang];
const project = getProjects(lang)[0];
const portfolioHref = lang === 'en' ? '/en/portfolio' : '/portfolio';
---

<section class="relative border-y border-line bg-parchment-200/30 pt-14 pb-16 md:pt-18 md:pb-24">
  <div class="shell">
    <div class="max-w-2xl reveal">
      <p class="eyebrow">{t.featuredEyebrow}</p>
      <h2 class="mt-4 text-[1.9rem] leading-tight font-bold tracking-[-0.025em] text-navy-950 sm:text-[2.4rem]">
        {t.featuredTitle}
      </h2>
      <p class="mt-3 text-[15px] leading-relaxed text-navy-700">
        {t.featuredDesc}
      </p>
    </div>

    {project && <ProjectCard project={project} lang={lang} class="mt-6 md:mt-8" />}

    <div class="mt-8 flex justify-center">
      <a href={portfolioHref} class="btn btn-ghost">
        {t.featuredAll}
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
