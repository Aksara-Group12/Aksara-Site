---
interface Props {
  src: string;
  alt: string;
  domain: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, domain, class: className = '', loading = 'lazy' } = Astro.props;
---

<figure class:list={['overflow-hidden rounded-xl border border-line bg-parchment-100/70', className]}>
  <div class="flex items-center gap-1.5 border-b border-line bg-parchment-50/80 px-3 py-2">
    <span class="size-2 rounded-full bg-tan-400/60"></span>
    <span class="size-2 rounded-full bg-gold-500/60"></span>
    <span class="size-2 rounded-full bg-steel-500/50"></span>
    <span class="ml-2 truncate font-mono text-[10px] tracking-wide text-navy-600">{domain}</span>
    <svg
      class="ml-auto size-3 shrink-0 text-navy-600/70"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <rect x="5" y="11" width="14" height="10" rx="2" />
      <path d="M8 11V7a4 4 0 0 1 8 0v4" stroke-linecap="round" />
    </svg>
  </div>
  <div class="overflow-hidden">
    <img
      src={src}
      alt={alt}
      width="1280"
      height="800"
      loading={loading}
      decoding="async"
      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
    />
  </div>
</figure>
