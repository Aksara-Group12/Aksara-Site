---
import type { Project } from '../data/projects';
import { ui, type Locale } from '../data/i18n';
import SitePreview from './SitePreview.astro';

interface Props {
  project: Project;
  class?: string;
  compact?: boolean;
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { project, class: className = '', compact = false, lang = detectedLocale } = Astro.props;

const t = ui[lang];
---

{
  compact ? (
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'project-card card reveal group relative flex h-full flex-col overflow-hidden p-0 transition-all duration-300 hover:border-gold-500/40 hover:shadow-lg',
        className,
      ]}
    >
      <!-- Card Preview Image -->
      <div class="border-b border-line bg-parchment-50/50 p-4 md:p-5 transition-opacity hover:opacity-95">
        <SitePreview
          src={project.preview}
          alt={project.previewAlt}
          domain={project.domain}
          class="shadow-[0_16px_36px_-24px_rgba(10,28,51,0.4)]"
        />
      </div>

      <!-- Card Body -->
      <div class="flex flex-1 flex-col p-5 md:p-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip text-xs">{project.industry}</span>
          <span class="chip text-xs">{project.year}</span>
          <span class="ml-auto flex items-center gap-1.5 font-mono text-[10px] tracking-wider text-gold-600 uppercase">
            <span class="size-1.5 rounded-full bg-gold-500 animate-pulse" />
            live
          </span>
        </div>

        <h3 class="mt-4 text-xl leading-snug font-semibold tracking-[-0.01em] text-navy-950 transition-colors group-hover:text-gold-600">
          {project.title}
        </h3>
        <p class="mt-1 text-sm font-medium text-navy-600">{project.client}</p>

        <p class="mt-3 text-[13.5px] leading-relaxed text-navy-700">
          {project.shortSummary}
        </p>

        <div class="mt-auto pt-5">
          <div class="flex items-center justify-between border-t border-line pt-3 text-xs">
            <span class="font-mono text-navy-800 font-semibold">{project.domain}</span>
            <span class="flex items-center gap-1 text-gold-600 font-medium">
              <span>{t.projectVisitBtn}</span>
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </div>
      </div>
    </a>
  ) : (
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'project-card card reveal group grid overflow-hidden p-0 transition-all duration-300 hover:border-gold-500/40 hover:shadow-lg lg:grid-cols-[1.08fr_0.92fr]',
        className,
      ]}
    >
      <!-- Card Preview Image -->
      <div class="border-b border-line bg-parchment-50/50 p-4 md:p-6 lg:border-r lg:border-b-0">
        <SitePreview
          src={project.preview}
          alt={project.previewAlt}
          domain={project.domain}
          class="shadow-[0_24px_50px_-36px_rgba(10,28,51,0.6)]"
        />
      </div>

      <!-- Card Body (Tampilan Full) -->
      <div class="flex flex-col justify-center p-6 md:p-8">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip text-xs">{project.industry}</span>
          <span class="chip text-xs">{project.year}</span>
          <span class="ml-auto flex items-center gap-1.5 font-mono text-[10px] tracking-wider text-gold-600 uppercase">
            <span class="size-1.5 rounded-full bg-gold-500 animate-pulse" />
            live
          </span>
        </div>

        <!-- Title & Client -->
        <h3 class="mt-4 text-2xl leading-snug font-bold tracking-[-0.01em] text-navy-950 transition-colors group-hover:text-gold-600 sm:text-[1.65rem]">
          {project.title}
        </h3>
        <p class="mt-1 text-sm font-medium text-navy-600">{project.client}</p>

        <!-- Ringkasan Lengkap -->
        <p class="mt-4 text-[14px] leading-relaxed text-navy-700">
          {project.summary}
        </p>

        <!-- Fitur Utama & Sorotan -->
        {project.highlights && project.highlights.length > 0 && (
          <ul class="mt-5 space-y-2">
            {project.highlights.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-navy-700">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold-500" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}

        <!-- Stack Teknologi -->
        <div class="mt-5 flex flex-wrap gap-1.5">
          {project.stack.map((tech) => (
            <span class="chip text-xs font-mono font-medium">{tech}</span>
          ))}
        </div>

        <!-- Footer Action -->
        <div class="mt-7 flex items-center justify-between gap-4 border-t border-line pt-5">
          <span class="min-w-0">
            <span class="block truncate font-mono text-xs font-semibold text-navy-800">{project.domain}</span>
            <span class="mt-0.5 block text-[11px] text-navy-600">{t.projectOpenNewTab}</span>
          </span>
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-full border border-line text-navy-700 transition-colors group-hover:border-gold-500 group-hover:text-gold-600 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  )
}
