---
import type { Project } from '../data/projects';
import { ui, type Locale } from '../data/i18n';
import SitePreview from './SitePreview.astro';

interface Props {
  project: Project;
  class?: string;
  compact?: boolean;
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { project, class: className = '', compact = false, lang = detectedLocale } = Astro.props;

const t = ui[lang];
const modalId = `modal-${project.slug}`;
---

<article
  class:list={[
    'project-card card reveal group relative flex flex-col overflow-hidden p-0 transition-all duration-300 hover:border-gold-500/40 hover:shadow-lg',
    compact ? 'h-full' : '',
    className,
  ]}
>
  <!-- Card Preview Image -->
  <div
    class="card-trigger cursor-pointer border-b border-line bg-parchment-50/50 p-4 md:p-5 transition-opacity hover:opacity-95"
    data-modal-target={modalId}
    role="button"
    tabindex="0"
    aria-label={`${t.projectOpenDetail} ${project.title}`}
  >
    <SitePreview
      src={project.preview}
      alt={project.previewAlt}
      domain={project.domain}
      class="shadow-[0_16px_36px_-24px_rgba(10,28,51,0.4)]"
    />
  </div>

  <!-- Card Body (Tampilan Awal Ringkas) -->
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="chip text-xs">{project.industry}</span>
      <span class="chip text-xs">{project.year}</span>
      <span class="ml-auto flex items-center gap-1.5 font-mono text-[10px] tracking-wider text-gold-600 uppercase">
        <span class="size-1.5 rounded-full bg-gold-500 animate-pulse"></span>
        live
      </span>
    </div>

    <!-- Title & Client -->
    <h3
      class="card-trigger mt-4 cursor-pointer text-xl leading-snug font-semibold tracking-[-0.01em] text-navy-950 transition-colors group-hover:text-gold-600"
      data-modal-target={modalId}
    >
      {project.title}
    </h3>
    <p class="mt-1 text-sm font-medium text-navy-600">{project.client}</p>

    <!-- Deskripsi Singkat -->
    <p class="mt-3 text-[13.5px] leading-relaxed text-navy-700">
      {project.shortSummary}
    </p>

    <!-- Tombol Buka Pop-up Detail -->
    <div class="mt-auto pt-5">
      <button
        type="button"
        class="card-trigger btn btn-ghost w-full justify-center gap-2 border-line bg-parchment-100/50 hover:bg-gold-500/10 hover:border-gold-500/60 text-xs py-2.5 px-4 font-semibold text-navy-900 transition-all hover:scale-[1.01]"
        data-modal-target={modalId}
      >
        <svg class="size-4 text-gold-600 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>{t.projectFullDetailBtn}</span>
      </button>
    </div>
  </div>

  <!-- Native HTML5 Dialog Pop-up Detail dengan Animasi Halus -->
  <dialog
    id={modalId}
    class="project-modal fixed inset-0 m-auto max-h-[90vh] w-[92vw] max-w-2xl overflow-y-auto rounded-2xl border border-line bg-parchment-50 p-0 text-navy-900 shadow-2xl"
  >
    <div class="flex flex-col">
      <!-- Modal Header -->
      <div class="sticky top-0 z-10 flex items-center justify-between border-b border-line bg-parchment-50/95 px-6 py-4 backdrop-blur-md">
        <div class="min-w-0 pr-4">
          <div class="flex items-center gap-2">
            <span class="chip text-[11px]">{project.industry}</span>
            <span class="chip text-[11px]">{project.year}</span>
          </div>
          <h2 class="mt-1.5 truncate text-lg font-bold text-navy-950 sm:text-xl">
            {project.title}
          </h2>
          <p class="text-xs text-navy-600 truncate">{project.client}</p>
        </div>

        <button
          type="button"
          class="modal-close-btn flex size-9 shrink-0 items-center justify-center rounded-full border border-line text-navy-600 transition-all hover:border-gold-500 hover:bg-gold-500/10 hover:text-navy-950 hover:rotate-90 duration-200"
          aria-label={t.projectCloseBtn}
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="space-y-6 p-6">
        <!-- Preview Mockup -->
        <div class="modal-item-animate overflow-hidden rounded-xl">
          <SitePreview
            src={project.preview}
            alt={project.previewAlt}
            domain={project.domain}
            class="shadow-md"
          />
        </div>

        <!-- Deskripsi Lengkap -->
        <div class="modal-item-animate">
          <h3 class="text-xs font-bold tracking-wider uppercase text-navy-600">{t.projectAboutTitle}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-800">
            {project.summary}
          </p>
        </div>

        <!-- Fitur & Sorotan -->
        {project.highlights && project.highlights.length > 0 && (
          <div class="modal-item-animate">
            <h3 class="text-xs font-bold tracking-wider uppercase text-navy-600">{t.projectHighlightsTitle}</h3>
            <ul class="mt-2 space-y-2">
              {project.highlights.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-navy-700">
                  <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gold-500"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Stack Teknologi -->
        <div class="modal-item-animate">
          <h3 class="text-xs font-bold tracking-wider uppercase text-navy-600">{t.projectStackTitle}</h3>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <span class="chip border-line bg-parchment-200/90 text-navy-800 text-xs font-mono font-medium px-2.5 py-1">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="sticky bottom-0 z-10 flex flex-wrap items-center justify-end gap-3 border-t border-line bg-parchment-50/95 px-6 py-4 backdrop-blur-md">
        <button
          type="button"
          class="modal-close-btn btn btn-ghost text-xs px-4 py-2 text-navy-700 hover:bg-parchment-200/60"
        >
          {t.projectCloseBtn}
        </button>

        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary text-xs px-5 py-2 font-semibold shadow-md flex items-center gap-2 hover:scale-[1.02] transition-transform"
        >
          <span>{t.projectVisitBtn} ({project.domain})</span>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </div>
  </dialog>
</article>

<style>
  /* Animasi Masuk Pop-up & Backdrop */
  .project-modal[open] {
    animation: modalPopIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .project-modal[open]::backdrop {
    animation: backdropFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Animasi Keluar Pop-up & Backdrop */
  .project-modal.modal-closing {
    animation: modalPopOut 0.22s cubic-bezier(0.32, 0, 0.67, 0) forwards;
  }

  .project-modal.modal-closing::backdrop {
    animation: backdropFadeOut 0.22s cubic-bezier(0.32, 0, 0.67, 0) forwards;
  }

  @keyframes modalPopIn {
    0% {
      opacity: 0;
      transform: scale(0.92) translateY(12px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes modalPopOut {
    0% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    100% {
      opacity: 0;
      transform: scale(0.94) translateY(8px);
    }
  }

  @keyframes backdropFadeIn {
    0% {
      opacity: 0;
      background-color: rgba(10, 28, 51, 0);
      backdrop-filter: blur(0px);
    }
    100% {
      opacity: 1;
      background-color: rgba(10, 28, 51, 0.65);
      backdrop-filter: blur(4px);
    }
  }

  @keyframes backdropFadeOut {
    0% {
      opacity: 1;
      background-color: rgba(10, 28, 51, 0.65);
      backdrop-filter: blur(4px);
    }
    100% {
      opacity: 0;
      background-color: rgba(10, 28, 51, 0);
      backdrop-filter: blur(0px);
    }
  }

  /* Stagger item animasi saat pop-up dibuka */
  .project-modal[open] .modal-item-animate {
    animation: itemSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .project-modal[open] .modal-item-animate:nth-child(1) { animation-delay: 0.05s; }
  .project-modal[open] .modal-item-animate:nth-child(2) { animation-delay: 0.1s; }
  .project-modal[open] .modal-item-animate:nth-child(3) { animation-delay: 0.15s; }
  .project-modal[open] .modal-item-animate:nth-child(4) { animation-delay: 0.2s; }

  @keyframes itemSlideUp {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function setupProjectModals() {
    // 1. Tangani pembukaan modal via tombol pemicu
    document.querySelectorAll<HTMLElement>('.card-trigger').forEach((trigger) => {
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';

      const openHandler = (e: Event) => {
        e.preventDefault();
        const targetId = trigger.dataset.modalTarget;
        if (!targetId) return;
        const dialog = document.getElementById(targetId) as HTMLDialogElement | null;
        if (dialog && !dialog.open) {
          dialog.showModal();
          document.body.classList.add('overflow-hidden');
        }
      };

      trigger.addEventListener('click', openHandler);
      trigger.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          openHandler(e);
        }
      });
    });

    // 2. Tangani penutupan modal dengan animasi halus
    document.querySelectorAll<HTMLDialogElement>('.project-modal').forEach((dialog) => {
      if (dialog.dataset.bound === 'true') return;
      dialog.dataset.bound = 'true';

      const closeModalWithAnimation = () => {
        dialog.classList.add('modal-closing');
        const handleAnimationEnd = () => {
          dialog.classList.remove('modal-closing');
          dialog.close();
          document.body.classList.remove('overflow-hidden');
          dialog.removeEventListener('animationend', handleAnimationEnd);
        };
        dialog.addEventListener('animationend', handleAnimationEnd);
      };

      // Tombol Tutup di dalam modal
      dialog.querySelectorAll('.modal-close-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          closeModalWithAnimation();
        });
      });

      // Klik pada Backdrop di luar modal
      dialog.addEventListener('click', (e: MouseEvent) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeModalWithAnimation();
        }
      });

      // Tombol Escape bawaan
      dialog.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeModalWithAnimation();
      });
    });
  }

  setupProjectModals();
  document.addEventListener('astro:page-load', setupProjectModals);
</script>
