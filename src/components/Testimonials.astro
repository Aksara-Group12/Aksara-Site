---
import { testimonials } from '../data/content';
---

<section class="relative border-t border-line py-20 md:py-28">
  <div class="shell">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between reveal">
      <div class="max-w-xl">
        <p class="eyebrow">Testimoni</p>
        <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
          Yang bicara seharusnya klien, bukan kami.
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-navy-600">
        Kutipan di bawah dikutip apa adanya dari wawancara singkat setelah proyek selesai.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        testimonials.map((item) => (
          <figure class="card reveal flex h-full flex-col p-6">
            <svg class="size-6 text-gold-500/40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.5 5.5c-3 1.4-4.6 3.7-4.6 6.9V18h5.4v-5.4H7.5c0-2 .9-3.2 2.6-3.9zm9 0c-3 1.4-4.6 3.7-4.6 6.9V18h5.4v-5.4h-2.8c0-2 .9-3.2 2.6-3.9z" />
            </svg>

            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-navy-900">
              {item.quote}
            </blockquote>

            <figcaption class="mt-6 flex items-center gap-3 border-t border-line pt-5">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-line bg-parchment-50 font-mono text-[11px] text-gold-600">
                {item.initials}
              </span>
              <div>
                <p class="text-sm font-medium text-navy-950">{item.name}</p>
                <p class="text-[11px] text-navy-600">{item.role} · {item.company}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
