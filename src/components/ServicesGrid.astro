---
import { services } from '../data/services';
import ServiceCardVisual from './ServiceCardVisual.astro';

const icons: Record<string, string> = {
  layout: 'M4 5h16v14H4zM4 10h16',
  app: 'M4 5h7v7H4zM13 5h7v4h-7zM13 12h7v7h-7zM4 15h7v4H4z',
  phone: 'M8 3h8v18H8zM11 18h2',
  cpu: 'M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2M5 5h14v14H5zM9 9h6v6H9z',
  shield: 'M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z',
};
---

<section class="relative border-t border-line pt-8 pb-20 md:pt-12 md:pb-28">
  <div class="shell">
    <div class="max-w-2xl reveal">
      <p class="eyebrow">Layanan</p>
      <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
        Layanan yang kami kerjakan dengan baik.
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-navy-700">
        Kami tidak mengerjakan semuanya. Fokus di lima area keahlian ini supaya hasilnya benar-benar matang,
        bukan sekadar bisa jalan.
      </p>
    </div>

    <div class="service-rail mt-12">
      {
        services.map((service, index) => (
          <article class="service-rail__item" data-active={index === 0 ? '' : undefined}>
            <div class="service-rail__head flex items-start justify-between gap-3">
              <h3 class="text-lg leading-snug font-semibold tracking-[-0.01em]">
                <button
                  type="button"
                  class="service-rail__toggle"
                  data-rail-toggle
                  aria-expanded={index === 0 ? 'true' : 'false'}
                >
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-current/25">
                    <svg
                      class="size-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={icons[service.icon]} />
                    </svg>
                  </span>
                  {service.shortTitle}
                </button>
              </h3>
              <span class="mt-1.5 font-mono text-[11px] opacity-60">{service.number}</span>
            </div>

            <div class="service-rail__panel">
              <div class="service-rail__panel-inner flex flex-col justify-between">
                <div class="pt-3">
                  <ServiceCardVisual slug={service.slug} />
                </div>
                <div class="pt-3">
                  <p class="text-sm leading-relaxed opacity-85">{service.summary}</p>
                  <div class="mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] font-medium">
                    <span class="font-mono font-semibold">{service.startingPrice}</span>
                    <span class="size-1 rotate-45 bg-current opacity-40"></span>
                    <span class="font-mono opacity-80">{service.timeline}</span>
                    <a
                      href={`/layanan#${service.slug}`}
                      class="ml-auto inline-flex items-center gap-1.5 text-xs font-semibold text-gold-600 underline-offset-4 hover:underline"
                    >
                      Selengkapnya
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const initRail = () => {
    document.querySelectorAll<HTMLElement>('.service-rail').forEach((rail) => {
      if (rail.dataset.railBound) return;
      rail.dataset.railBound = '1';

      rail.addEventListener('click', (event) => {
        const item = (event.target as HTMLElement).closest<HTMLElement>('.service-rail__item');
        if (!item || event.target instanceof Element && event.target.closest('a')) return;

        rail.querySelectorAll<HTMLElement>('.service-rail__item').forEach((el) => {
          const active = el === item;
          el.toggleAttribute('data-active', active);
          const btn = el.querySelector<HTMLButtonElement>('[data-rail-toggle]');
          if (btn) btn.setAttribute('aria-expanded', String(active));
        });
      });
    });
  };

  initRail();
  document.addEventListener('astro:page-load', initRail);
</script>
