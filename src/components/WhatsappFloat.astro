---
import { waLink } from '../data/site';
import { ui, type Locale } from '../data/i18n';

interface Props {
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { lang = detectedLocale } = Astro.props;

const t = ui[lang];
---

<a
  href={waLink(undefined, lang)}
  target="_blank"
  rel="noopener"
  aria-label={t.waFloatText}
  class="group fixed right-4 bottom-4 z-40 flex items-center gap-2.5 rounded-full border border-gold-500/30 bg-parchment-50/90 py-2.5 pr-4 pl-2.5 shadow-lg shadow-black/25 backdrop-blur-md transition-colors hover:border-gold-500 md:right-6 md:bottom-6"
>
  <span class="flex size-8 items-center justify-center rounded-full bg-deep-900 text-on-deep">
    <svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2m0 1.8c2.16 0 4.2.84 5.72 2.37a8.05 8.05 0 0 1 2.37 5.72c0 4.47-3.63 8.1-8.1 8.1a8.1 8.1 0 0 1-4.12-1.13l-.3-.17-3.14.82.84-3.06-.19-.32a8.06 8.06 0 0 1-1.25-4.32c0-4.47 3.64-8.1 8.11-8.1m-3.6 4.3c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.6c.13.18 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.1-.23-.17-.48-.29-.25-.13-1.47-.73-1.7-.81-.23-.09-.4-.13-.56.12-.17.25-.65.81-.8.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.38-1.72c-.14-.25-.01-.38.11-.5.11-.12.25-.29.37-.44.13-.14.17-.25.25-.42.09-.16.04-.31-.02-.44-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42z" />
    </svg>
  </span>
  <span class="text-[13px] font-semibold text-navy-950">{t.waFloatText}</span>
</a>
