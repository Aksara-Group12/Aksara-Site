---
import { techLogos } from '../data/techLogos';
import { ui, type Locale } from '../data/i18n';

interface Props {
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { lang = detectedLocale } = Astro.props;

const t = ui[lang];
---

<section class="relative border-y border-line bg-parchment-200/30 py-20 md:py-28">
  <div class="shell">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center before:hidden">{t.techEyebrow}</p>
      <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] sm:text-4xl">
        {t.techTitle}
      </h2>
    </div>
  </div>

  <div class="marquee marquee--tech mt-14">
    <div class="marquee__track gap-10 lg:gap-14">
      <div class="flex items-center gap-10 lg:gap-14">
        {
          techLogos.map(({ label, icon }) => (
            <span class="tech-logo" title={label}>
              <svg viewBox="0 0 24 24" class="size-9" role="img" aria-label={label}>
                <path d={icon.path} fill={`#${icon.hex}`} />
              </svg>
            </span>
          ))
        }
      </div>
      <div class="flex items-center gap-10 lg:gap-14" aria-hidden="true">
        {
          techLogos.map(({ label, icon }) => (
            <span class="tech-logo">
              <svg viewBox="0 0 24 24" class="size-9" aria-hidden="true">
                <path d={icon.path} fill={`#${icon.hex}`} />
              </svg>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
