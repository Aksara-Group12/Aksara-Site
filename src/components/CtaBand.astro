---
import { waLink } from '../data/site';
import { ui, type Locale } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { lang = detectedLocale } = Astro.props;

const t = ui[lang];

const {
  title = t.ctaDefaultTitle,
  description = t.ctaDefaultDesc,
  primaryLabel = t.ctaPrimaryLabel,
  secondaryLabel = t.ctaSecondaryLabel,
  secondaryHref = lang === 'en' ? '/en/services' : '/layanan',
} = Astro.props;
---

<section class="relative overflow-hidden py-20 md:py-28">
  <div class="shell relative">
    <div
      class="surface-navy relative overflow-hidden rounded-3xl border border-gold-500/30 px-6 py-16 text-center shadow-[0_40px_80px_-50px_rgba(10,28,51,0.9)] md:px-16 md:py-20"
    >
      <div class="grid-lines opacity-25"></div>
      <div class="glow -top-40 left-1/2 size-[34rem] -translate-x-1/2 text-gold-400/15"></div>

      <div class="relative mx-auto max-w-2xl">
        <div class="rule-ornament mx-auto max-w-[12rem]">
          <span class="diamond"></span>
        </div>

        <p class="eyebrow eyebrow-light mt-8 justify-center before:hidden">{t.ctaNextStep}</p>
        <h2 class="mt-5 text-3xl leading-tight font-bold tracking-[-0.02em] text-on-deep sm:text-4xl">
          {title}
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-[15px] leading-relaxed text-on-deep-muted/80">{description}</p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={waLink(undefined, lang)} target="_blank" rel="noopener" class="btn btn-gold">
            {primaryLabel}
          </a>
          <a href={secondaryHref} class="btn btn-outline-light">{secondaryLabel}</a>
        </div>

        <p class="mt-7 text-[11px] tracking-[0.14em] text-on-deep-muted/50 uppercase">
          {t.ctaResponseTime}
        </p>
      </div>
    </div>
  </div>
</section>
