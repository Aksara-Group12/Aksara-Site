---
import { site, getSite, getNav, waLink } from '../data/site';
import { getEquivalentPath, ui, type Locale } from '../data/i18n';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  lang?: Locale;
}

const path = Astro.url.pathname;
const detectedLocale: Locale = path === '/en' || path.startsWith('/en/') ? 'en' : 'id';
const { lang = detectedLocale } = Astro.props;

const t = ui[lang];
const navItems = getNav(lang);
const homeHref = lang === 'en' ? '/en' : '/';
const currentSite = getSite(lang);

const idPath = getEquivalentPath(path, 'id');
const enPath = getEquivalentPath(path, 'en');

const isActive = (href: string) => {
  if (href === '/' || href === '/en') {
    return path === href;
  }
  return path === href || path.startsWith(href);
};
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 [&.is-scrolled]:border-line [&.is-scrolled]:bg-parchment-100/95"
>
  <div class="shell flex h-14 items-center justify-between gap-6 md:h-16">
    <a href={homeHref} class="group flex items-center gap-2" aria-label={`${currentSite.name} — ${homeHref}`}>
      <span class="logo-chip h-[15px] w-[13px] transition-transform duration-300 group-hover:-translate-y-0.5">
        <LogoMark class="logo-mark--fill" />
      </span>
      <span class="text-serif text-[15px] leading-none font-semibold text-navy-950">
        Aksara<span class="ml-1.5 text-navy-600">Developer</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t.navAria}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-gold-700 font-semibold'
                : 'text-navy-700 hover:text-navy-950',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-3.5 -bottom-0.5 h-px bg-gold-500" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Desktop Language Selector -->
      <div class="relative hidden sm:block" data-lang>
        <button
          type="button"
          data-lang-toggle
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="lang-menu"
          class="flex h-10 items-center gap-1.5 rounded-full border border-line-strong px-3 text-xs font-semibold text-navy-900 transition-colors hover:border-gold-500 hover:text-gold-700"
        >
          <svg class="size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span class="uppercase">{lang}</span>
          <svg
            class="lang-caret size-3 text-navy-600 transition-transform duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div
          id="lang-menu"
          data-lang-menu
          hidden
          role="menu"
          aria-label={t.langSelectAria}
          class="absolute top-full right-0 z-50 mt-2 w-48 rounded-2xl border border-line bg-parchment-50 p-1.5 shadow-[0_24px_48px_-24px_rgba(10,28,51,0.45)]"
        >
          {
            lang === 'id' ? (
              <div
                role="menuitemradio"
                aria-checked="true"
                class="flex w-full items-center justify-between gap-3 rounded-xl bg-parchment-200 px-3 py-2 text-left text-sm font-medium text-navy-950"
              >
                <span>Indonesia</span>
                <svg class="size-4 text-gold-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            ) : (
              <a
                href={idPath}
                role="menuitemradio"
                aria-checked="false"
                class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left text-sm text-navy-700 transition-colors hover:bg-parchment-200/60 hover:text-navy-950"
              >
                <span>Indonesia</span>
              </a>
            )
          }

          {
            lang === 'en' ? (
              <div
                role="menuitemradio"
                aria-checked="true"
                class="flex w-full items-center justify-between gap-3 rounded-xl bg-parchment-200 px-3 py-2 text-left text-sm font-medium text-navy-950"
              >
                <span>English</span>
                <svg class="size-4 text-gold-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            ) : (
              <a
                href={enPath}
                role="menuitemradio"
                aria-checked="false"
                class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left text-sm text-navy-700 transition-colors hover:bg-parchment-200/60 hover:text-navy-950"
              >
                <span>English</span>
              </a>
            )
          }
        </div>
      </div>

      <button
        type="button"
        data-theme-toggle
        aria-label={t.darkMode}
        aria-pressed="false"
        title={t.titleDarkMode}
        class="flex size-10 items-center justify-center rounded-full border border-line-strong text-navy-900 transition-colors hover:border-gold-500 hover:text-gold-700"
      >
        <svg class="theme-icon--moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="theme-icon--sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.openMenu}
        class="flex size-10 items-center justify-center rounded-full border border-line-strong text-navy-900 md:hidden"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu hidden class="border-t border-line bg-parchment-100/97 backdrop-blur-xl md:hidden">
    <nav class="shell flex flex-col gap-1 py-4" aria-label={t.mobileNavAria}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-xl px-3 py-3 text-[15px] font-medium transition-colors',
              isActive(item.href) ? 'bg-parchment-200 text-gold-700 font-semibold' : 'text-navy-900 hover:bg-parchment-200/60',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-2 flex items-center justify-between gap-3 rounded-xl border border-line px-3 py-2.5">
        <span class="text-[10px] font-semibold tracking-[0.18em] text-navy-600 uppercase">{t.language}</span>
        <div class="flex items-center gap-1.5">
          {
            lang === 'id' ? (
              <span class="rounded-full bg-parchment-200 px-3 py-1 text-xs font-semibold text-navy-950">ID</span>
            ) : (
              <a href={idPath} class="rounded-full border border-line px-3 py-1 text-xs font-medium text-navy-600 hover:text-navy-950 transition-colors">
                ID
              </a>
            )
          }
          {
            lang === 'en' ? (
              <span class="rounded-full bg-parchment-200 px-3 py-1 text-xs font-semibold text-navy-950">EN</span>
            ) : (
              <a href={enPath} class="rounded-full border border-line px-3 py-1 text-xs font-medium text-navy-600 hover:text-navy-950 transition-colors">
                EN
              </a>
            )
          }
        </div>
      </div>
      <a href={waLink(undefined, lang)} target="_blank" rel="noopener" class="btn btn-primary mt-2 w-full">{t.freeConsultation}</a>
    </nav>
  </div>
</header>

<script>
  const initChrome = () => {
    const root = document.documentElement;

    const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (menuToggle && menu && menuToggle.dataset.bound !== 'true') {
      menuToggle.dataset.bound = 'true';
      const setMenu = (open: boolean) => {
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
        menu.hidden = !open;
      };
      menuToggle.addEventListener('click', () =>
        setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'),
      );
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    }

    const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const syncTheme = () => {
      const dark = root.classList.contains('dark');
      root.style.colorScheme = dark ? 'dark' : 'light';
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', dark ? '#0b1219' : '#f9efd9');
      if (themeToggle) {
        themeToggle.setAttribute('aria-pressed', String(dark));
        themeToggle.setAttribute('aria-label', dark ? 'Aktifkan mode terang' : 'Aktifkan mode gelap');
        themeToggle.setAttribute('title', dark ? 'Mode Terang' : 'Mode Gelap');
      }
    };
    if (themeToggle && themeToggle.dataset.bound !== 'true') {
      themeToggle.dataset.bound = 'true';
      themeToggle.addEventListener('click', (event) => {
        const dark = !root.classList.contains('dark');

        // Micro-animation spin pada ikon tema
        themeToggle.classList.add('theme-toggle-spin');
        setTimeout(() => themeToggle.classList.remove('theme-toggle-spin'), 550);

        const rect = themeToggle.getBoundingClientRect();
        const mouseEvent = event as MouseEvent;
        const x = mouseEvent.clientX && mouseEvent.clientX > 0 ? mouseEvent.clientX : rect.left + rect.width / 2;
        const y = mouseEvent.clientY && mouseEvent.clientY > 0 ? mouseEvent.clientY : rect.top + rect.height / 2;

        const applyNewTheme = () => {
          root.classList.add('theme-transitioning');
          root.classList.toggle('dark', dark);
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {
            /* storage unavailable */
          }
          syncTheme();
          setTimeout(() => {
            root.classList.remove('theme-transitioning');
          }, 500);
        };

        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (isReducedMotion) {
          applyNewTheme();
          return;
        }

        // --- DUAL GOLDEN RIPPLE SHOCKWAVE (Transparan, konten tidak tertutup, zero-jump) ---
        const container = document.createElement('div');
        container.className = 'theme-wave-container';
        container.style.cssText = `
          position: fixed;
          inset: 0;
          pointer-events: none;
          z-index: 999999;
          overflow: hidden;
        `;

        const maxRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        );
        const targetDiameter = maxRadius * 2.4;

        const baseRingStyle = `
          position: absolute;
          left: ${x}px;
          top: ${y}px;
          width: 30px;
          height: 30px;
          margin-left: -15px;
          margin-top: -15px;
          border-radius: 50%;
          pointer-events: none;
          transform: scale(0);
          will-change: transform, opacity;
        `;

        // 1. Cincin Gelombang Utama (Golden Ripple Utama)
        const ring1 = document.createElement('div');
        ring1.style.cssText = baseRingStyle + `
          border: 3px solid rgba(217, 177, 102, 0.85);
          box-shadow: 0 0 40px 14px rgba(217, 177, 102, 0.6), inset 0 0 20px 6px rgba(217, 177, 102, 0.35);
        `;

        // 2. Cincin Gelombang Kedua (Echo Ripple Wave)
        const ring2 = document.createElement('div');
        ring2.style.cssText = baseRingStyle + `
          border: 1.5px solid rgba(217, 177, 102, 0.65);
          box-shadow: 0 0 25px 8px rgba(217, 177, 102, 0.35);
        `;

        // 3. Aura Radial Glow Lembut di Pusat Riak
        const aura = document.createElement('div');
        aura.style.cssText = baseRingStyle + `
          background: radial-gradient(circle, rgba(217, 177, 102, 0.25) 0%, rgba(217, 177, 102, 0.08) 60%, transparent 100%);
        `;

        container.appendChild(aura);
        container.appendChild(ring1);
        container.appendChild(ring2);
        document.body.appendChild(container);

        // Eksekusi pergantian tema secara bersamaan dengan sapuan riak
        applyNewTheme();

        const scaleTarget = targetDiameter / 30;

        // Animasi Cincin 1 (Primary Ripple)
        ring1.animate(
          [
            { transform: 'scale(0)', opacity: 1 },
            { transform: `scale(${scaleTarget * 0.45})`, opacity: 0.9, offset: 0.35 },
            { transform: `scale(${scaleTarget})`, opacity: 0 }
          ],
          {
            duration: 720,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'forwards'
          }
        );

        // Animasi Cincin 2 (Secondary Echo Ripple)
        ring2.animate(
          [
            { transform: 'scale(0)', opacity: 0 },
            { transform: 'scale(0.3)', opacity: 0.85, offset: 0.15 },
            { transform: `scale(${scaleTarget})`, opacity: 0 }
          ],
          {
            duration: 800,
            delay: 80,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'forwards'
          }
        );

        // Animasi Aura Glow
        aura.animate(
          [
            { transform: 'scale(0)', opacity: 1 },
            { transform: `scale(${scaleTarget * 0.6})`, opacity: 0.6, offset: 0.4 },
            { transform: `scale(${scaleTarget})`, opacity: 0 }
          ],
          {
            duration: 650,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'forwards'
          }
        );

        // Bersihkan kontainer setelah gelombang selesai menyapu
        setTimeout(() => {
          container.remove();
        }, 900);
      });
    }
    syncTheme();

    const langContainer = document.querySelector<HTMLElement>('[data-lang]');
    const langToggle = document.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    const langMenu = document.querySelector<HTMLElement>('[data-lang-menu]');
    if (langContainer && langToggle && langMenu && langContainer.dataset.bound !== 'true') {
      langContainer.dataset.bound = 'true';
      const setOpen = (open: boolean) => {
        langToggle.setAttribute('aria-expanded', String(open));
        langMenu.hidden = !open;
      };
      langToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setOpen(langMenu.hidden);
      });
      document.addEventListener('click', (event) => {
        if (!langContainer.contains(event.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });
    }
  };

  initChrome();
  document.addEventListener('astro:page-load', initChrome);
</script>
